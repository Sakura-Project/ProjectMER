  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="copy /Y &quot;$(TargetPath)&quot; &quot;%APPDATA%\SCP Secret Laboratory\LabAPI\plugins\7777\$(TargetName).dll&quot;" />
