<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>default</LangVersion>
    <TargetFramework>net4.8</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Configurations>Debug;Release;Exiled</Configurations>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Exiled|x64' ">
    <Optimize>true</Optimize>
    <DefineConstants>EXILED,TRACE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Aqua.API">
      <HintPath>..\..\AquaPlugins\Aqua.API\bin\Release\Aqua.API.dll</HintPath>
    </Reference>
    <Reference Include="Aqua.CustomItems">
      <HintPath>..\..\AquaPlugins\Aqua.CustomItems\bin\Release\Aqua.CustomItems.dll</HintPath>
    </Reference>
    <Reference Include="Aqua.CustomRoles">
      <HintPath>..\..\AquaPlugins\Aqua.CustomRoles\bin\Release\Aqua.CustomRoles.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>..\..\..\DLL\publicized_assemblies\Assembly-CSharp_publicized.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>..\..\..\DLL\Assembly-CSharp-firstpass.dll</HintPath>
    </Reference>
    <Reference Include="CommandSystem.Core">
      <HintPath>..\..\..\DLL\CommandSystem.Core.dll</HintPath>
    </Reference>
    <Reference Include="Exiled.API" Condition=" '$(Configuration)|$(Platform)' == 'Exiled|x64' ">
      <HintPath>..\..\..\DLL\EXILED\Exiled.API.dll</HintPath>
    </Reference>
    <Reference Include="Exiled.CustomItems" Condition=" '$(Configuration)|$(Platform)' == 'Exiled|x64' ">
      <HintPath>..\..\..\DLL\EXILED\Exiled.CustomItems.dll</HintPath>
    </Reference>
    <Reference Include="HintServiceMeow">
      <HintPath>..\..\AquaPlugins\dependencies\HintServiceMeow-LabAPI.dll</HintPath>
    </Reference>
    <Reference Include="LabApi">
      <HintPath>..\..\..\DLL\LabApi.dll</HintPath>
    </Reference>
    <Reference Include="Mirror">
      <HintPath>..\..\..\DLL\publicized_assemblies\Mirror_publicized.dll</HintPath>
    </Reference>
    <Reference Include="mscorlib">
      <HintPath>..\..\..\DLL\mscorlib.dll</HintPath>
    </Reference>
    <Reference Include="NorthwoodLib">
      <HintPath>..\..\..\DLL\NorthwoodLib.dll</HintPath>
    </Reference>
    <Reference Include="Pooling">
      <HintPath>..\..\..\DLL\Pooling.dll</HintPath>
    </Reference>
    <Reference Include="System">
      <HintPath>..\..\..\DLL\System.dll</HintPath>
